NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Human release gates. Keep false until the named review is documented.
PRODUCT_CATALOG_APPROVED=false
EDITORIAL_CONTENT_APPROVED=false
LEGAL_CONTENT_APPROVED=false
OPERATIONS_RELEASE_APPROVED=false

# Local infrastructure
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bangla_blend
REDIS_URL=redis://localhost:6379
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=local-development-master-key

# Optional Medusa object storage. Set every value to enable the S3 file provider.
S3_FILE_URL=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Medusa Admin RBAC and local-only superadmin bootstrap.
# Copy these to apps/medusa/.env; production must provide different secret-managed values.
MEDUSA_FF_RBAC=true
SUPERADMIN_EMAIL=superadmin@banglablend.local
SUPERADMIN_PASSWORD=BanglaBlend-Local-Admin-2026!
SUPERADMIN_FIRST_NAME=Bangla Blend
SUPERADMIN_LAST_NAME=Superadmin
