# Production deployment variables for Bangla Blend.
#
# Copy per service, fill in real values, and load them from your platform's secret store
# (AWS Secrets Manager / SSM Parameter Store, or your host's environment settings).
# NEVER commit a filled-in copy of this file.
#
# Verify with:  NODE_ENV=production pnpm check:production
#
# BUILD-TIME vs RUNTIME:
#   Every NEXT_PUBLIC_* value is inlined into the client bundle when the image is BUILT.
#   Pass those as --build-arg. Changing one requires rebuilding the image, not just restarting it.
#   Everything else is read at runtime and can be supplied as ordinary container env vars.

NODE_ENV=production

# ---- Public origins (must be HTTPS; Admin uses a dedicated subdomain) ----
NEXT_PUBLIC_SITE_URL=https://banglablend.store
NEXT_PUBLIC_STOREFRONT_URL=https://banglablend.store
NEXT_PUBLIC_ADMIN_URL=https://bpanel.banglablend.store
NEXT_PUBLIC_CONTACT_EMAIL=banglablend@gmail.com

# ---- Supabase (project ref fwcwhiprbaqqwiyryhpa) ----
# The anon key is public by design and RLS-scoped. The service-role key bypasses RLS entirely:
# keep it server-only, never in a NEXT_PUBLIC_ variable, and rotate it if it is ever exposed.
SUPABASE_PROJECT_REF=fwcwhiprbaqqwiyryhpa
NEXT_PUBLIC_SUPABASE_URL=https://fwcwhiprbaqqwiyryhpa.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Deployment-only credentials used to link a fresh checkout and apply every pending cloud change.
# Create the access token under Supabase Account > Access Tokens.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Deployment-only: used by pnpm auth:configure-google, not by the running storefront.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- Cache revalidation ----
# Shared secret the admin app sends to the storefront's /api/revalidate/content.
# Must be at least 32 characters and independent of every other secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# ---- Markets and payments ----
NEXT_PUBLIC_DEFAULT_MARKET=bd
NEXT_PUBLIC_DEFAULT_CURRENCY=BDT
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# No international payment provider is implemented yet; check:production rejects true.
ENABLE_INTERNATIONAL_CHECKOUT=false

# At least one of these must be true.
COD_ENABLED=true
SSLCOMMERZ_ENABLED=false
# Required when SSLCOMMERZ_ENABLED=true, and SSLCOMMERZ_SANDBOX must be false for a real release.
SSLCOMMERZ_SANDBOX=false
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# ---- Email ----
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=orders@banglablend.store

# ---- Analytics (optional) ----
ANALYTICS_PROVIDER=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Release gates ----
# check:production requires all four to be true. Each represents a human sign-off, not a
# formality: set one only once the named review has actually happened and is recorded.
#   PRODUCT_CATALOG_APPROVED   -- catalog, pricing, stock, and product claims reviewed
#   EDITORIAL_CONTENT_APPROVED -- editorial, imagery, and sourcing claims reviewed
#   LEGAL_CONTENT_APPROVED     -- policies, terms, and legal pages reviewed
#   OPERATIONS_RELEASE_APPROVED-- fulfilment, payments, and support readiness reviewed
PRODUCT_CATALOG_APPROVED=false
EDITORIAL_CONTENT_APPROVED=false
LEGAL_CONTENT_APPROVED=false
OPERATIONS_RELEASE_APPROVED=false

# Sample/placeholder content. check:production rejects true; never enable in production.
ENABLE_DEVELOPMENT_FALLBACKS=false
