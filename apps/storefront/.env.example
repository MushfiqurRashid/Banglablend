NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Supabase (backend + CMS). See supabase/migrations for schema, supabase/seed for local data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_SEARCH_KEY=
MEILISEARCH_ADMIN_KEY=

NEXT_PUBLIC_DEFAULT_MARKET=bd
NEXT_PUBLIC_DEFAULT_CURRENCY=BDT
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
ENABLE_INTERNATIONAL_CHECKOUT=false

COD_ENABLED=true
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Shared secret the content-publishing admin app sends in the x-revalidate-secret header to
# invalidate cached content after a publish (see /api/revalidate/content).
REVALIDATE_SECRET=

# Human release gates are checked by pnpm check:production.
PRODUCT_CATALOG_APPROVED=false
EDITORIAL_CONTENT_APPROVED=false
LEGAL_CONTENT_APPROVED=false
OPERATIONS_RELEASE_APPROVED=false

# Sample content is only permitted in local development.
ENABLE_DEVELOPMENT_FALLBACKS=true

EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=hello@example.com
ANALYTICS_PROVIDER=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
