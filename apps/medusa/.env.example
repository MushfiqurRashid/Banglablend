NODE_ENV=development
MEDUSA_BACKEND_URL=http://localhost:9000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bangla_blend
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECRET=replace-with-at-least-32-random-characters
ADMIN_CORS=http://localhost:9000
STORE_CORS=http://localhost:3000
AUTH_CORS=http://localhost:3000,http://localhost:9000
MEDUSA_FF_RBAC=true

# Local-only bootstrap credentials used by `pnpm seed:superadmin`.
# Production refuses these defaults and requires explicit secret-managed values.
SUPERADMIN_EMAIL=superadmin@banglablend.local
SUPERADMIN_PASSWORD=BanglaBlend-Local-Admin-2026!
SUPERADMIN_FIRST_NAME=Bangla Blend
SUPERADMIN_LAST_NAME=Superadmin

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_SUCCESS_URL=http://localhost:3000/api/payments/sslcommerz/success
SSLCOMMERZ_FAIL_URL=http://localhost:3000/api/payments/sslcommerz/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:3000/api/payments/sslcommerz/cancel
SSLCOMMERZ_IPN_URL=http://localhost:3000/api/payments/sslcommerz/ipn

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_ADMIN_KEY=local-development-master-key

SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_READ_TOKEN=

# Leave any value empty to keep Medusa's default local file provider.
S3_FILE_URL=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=hello@example.com
STOREFRONT_URL=http://localhost:3000
